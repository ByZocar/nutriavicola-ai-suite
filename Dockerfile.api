# Imagen para la API REST (FastAPI). Separada del dashboard para escalar independiente.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY data/processed/ ./data/processed/

# Render inyecta PORT; uvicorn lo respeta
ENV PORT=8000
EXPOSE 8000

CMD uvicorn nutria_ai.api.app:app --host 0.0.0.0 --port ${PORT}
