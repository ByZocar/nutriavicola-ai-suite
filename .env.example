# Variables de entorno del proyecto. Copiar a .env y completar.
# El archivo .env real está ignorado por git (nunca se sube).

# Rutas de datos
RUTA_TICKETS_RAW=data/raw/Reto2.txt
RUTA_EMPLEADOS_RAW=data/raw/empleados.xlsx
RUTA_PROCESADOS=data/processed

# API del extra
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard
DASHBOARD_PORT=8501

# --- Seguridad de la API ---
# Clave que Power Automate envía en el header 'X-API-Key'. Si se deja vacía,
# la API corre en modo desarrollo sin exigir clave. En producción es obligatoria.
API_KEY=genera_una_clave_larga_y_aleatoria

# Secreto para firmar los enlaces de descarga (HMAC). Usa un valor largo y único.
SECRETO_FIRMA=genera_otro_secreto_largo_y_aleatorio

# Minutos de validez del enlace de descarga del certificado
MINUTOS_VALIDEZ_DESCARGA=15

# URL pública de la API (para construir el enlace de descarga)
BASE_URL=https://nutriavicola-api.onrender.com
